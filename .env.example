# EarthTrend AI - environment variables (copy to .env for local use).
# .env is ignored by Git. NEVER put a real key in this example file.

# --- Application -----------------------------------------------------------
APP_ENV=development            # development | test | production (production enables HSTS, hides /docs)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LLM=10/minute       # per client IP, on /explain and /ask
RATE_LIMIT_LLM_GLOBAL=30/minute  # all clients together: keep BELOW the free LLM quota
RATE_LIMIT_COMPUTE=30/minute   # per client IP, on /analyze

# --- Client IP behind a proxy (production) ----------------------------------
TRUSTED_PROXY_HOPS=0           # 0 locally; confirm the value on Render with DEBUG_CLIENT_IP
CLIENT_IP_HEADER=              # optional, e.g. CF-Connecting-IP
DEBUG_CLIENT_IP=false          # true shows the detected IP on /health (first deploy only)

# --- Validation ------------------------------------------------------------
ALLOWED_VARIABLES=T2M,PRECTOTCORR
MIN_YEAR=1981
# MAX_YEAR defaults to the current year
MIN_PERIOD_YEARS=5
QUESTION_MIN_CHARS=3
QUESTION_MAX_CHARS=300
MAX_BODY_BYTES=65536           # api/server.py receives time series of up to 1200 monthly rows

# --- Content Security Policy -----------------------------------------------
CSP_REPORT_ONLY=false          # true = report problems in the browser console without blocking
CSP_EXTRA_SCRIPT_SRC=          # extra script hosts, comma separated
CSP_EXTRA_CONNECT_SRC=         # extra API hosts the browser calls, comma separated

# --- LLM (free offer not chosen yet) ----------------------------------------
LLM_PROVIDER=none              # none | anthropic | gemini | groq | openrouter | mistral | ollama | openai_compatible
LLM_MODEL=
LLM_API_KEY=                   # set it in Render / GitHub secrets, never in the repo
LLM_BASE_URL=                  # only for openai_compatible
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=1024
LLM_MAX_CONCURRENCY=4
LLM_CACHE_TTL_S=3600
